# Agent Bridge 环境变量模板 —— 密钥只从 ENV 注入，禁止写入 config/*.yaml 或代码库
# 复制为 .env（uv run 会自动加载 python-dotenv，如未安装可自行 export）

# 配置目录（默认 <项目根>/config）
AGENT_BRIDGE_CONFIG_DIR=

# 服务
AGENT_BRIDGE_SERVER__HOST=127.0.0.1
AGENT_BRIDGE_SERVER__PORT=8000

# LLM（默认 mock，确定性假回复+假流式 token；配齐 base_url+key 后改 provider 即走真实模型）
AGENT_BRIDGE_LLM__PROVIDER=mock
AGENT_BRIDGE_LLM__BASE_URL=
AGENT_BRIDGE_LLM__API_KEY=
AGENT_BRIDGE_LLM__MODEL=gpt-4o-mini
AGENT_BRIDGE_LLM__STREAM=true
# 官方主备链：主模型为上面的 MODEL，这里按顺序给出备用模型（JSON 数组）。
# 仅 provider=openai_compatible 时生效；Genesis 约定：deepseek-v4.1-flash → qwen3.8-27b → glm-5.3-flash
AGENT_BRIDGE_LLM__FALLBACK_MODELS=[]

# native 工具真发网络请求开关（默认关，走确定性 mock 响应）
AGENT_BRIDGE_TOOLS__ENABLE_REAL_HTTP=false

# 写操作默认模拟；只有显式设 true 且调用方 confirm_writes=true 才真正写入
AGENT_BRIDGE_ALLOW_WRITES=false

# Skills
AGENT_BRIDGE_SKILLS__ROOTS=C:/Users/Administrator/.workbuddy/skills

# Sandbox
AGENT_BRIDGE_SANDBOX__DEFAULT_TIMEOUT_S=30
AGENT_BRIDGE_SANDBOX__MAX_TIMEOUT_S=120

# 乐享 MCP（拿到独立服务 endpoint/token 后填入，并把 mcp_servers.yaml 的 transport 改为 streamable_http）
AGENT_BRIDGE_LEXIANG_TOKEN=
AGENT_BRIDGE_LEXIANG_ENDPOINT=

# GitHub MCP（G3 只需最小配置）
AGENT_BRIDGE_GITHUB_TOKEN=

# MOI / A2A（可选，阶段4多agent协作扩展用；详见 CREDENTIALS.md）
AGENT_BRIDGE_MOI__API_KEY=
AGENT_BRIDGE_MOI__WORKSPACE_ID=
AGENT_BRIDGE_A2A__PUBLIC_URL=

# 真实 live 用例开关（默认关闭）
RUN_LIVE=0

# 凭证填写逐步说明见 CREDENTIALS.md —— 真实密钥只写 .env，禁止提交 git
